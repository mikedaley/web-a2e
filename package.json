{
  "name": "web-a2e",
  "version": "1.0.0",
  "description": "Apple //e emulator for the browser",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:exports": "scripts/check-exports.sh",
    "check:core-purity": "scripts/check-core-purity.sh",
    "check:basic-tokens": "node scripts/generate-basic-tokens.mjs --check",
    "check:rom-defaults": "node scripts/generate-rom-defaults.mjs --check",
    "generate:basic-tokens": "node scripts/generate-basic-tokens.mjs",
    "generate:rom-defaults": "node scripts/generate-rom-defaults.mjs",
    "check": "npm run check:exports && npm run check:core-purity && npm run check:basic-tokens && npm run check:rom-defaults && npm test",
    "build": "npm run build:wasm && vite build",
    "build:wasm": "mkdir -p build && cd build && emcmake cmake .. && emmake make -j$(nproc 2>/dev/null || sysctl -n hw.ncpu)",
    "preview": "vite preview",
    "clean": "rm -rf build dist public/a2e.js public/a2e.wasm",
    "deploy": "scripts/deploy.sh production",
    "deploy:staging": "scripts/deploy.sh staging"
  },
  "devDependencies": {
    "fflate": "^0.8.2",
    "vite": "^7.3.1",
    "vitest": "^4.1.10",
    "ws": "^8.19.0"
  }
}
